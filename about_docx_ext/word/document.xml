s/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t>Our Story and Our People</w:t></w:r></w:p><w:p w14:paraId="6BE62300"><w:pPr><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4DB9B290"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Launched in 2013, Niche Techies is a USA-based software development and staffing company. Headquartered in Westerville, Ohio, we build scalable and sustainable technology solutions by integrating artificial intelligence innovation with traditional software development. Currently, we are present in 5 leading countries of the world: the USA, the UK, France, South Korea and Au</w:t></w:r><w:bookmarkStart w:id="0" w:name="_GoBack"/><w:bookmarkEnd w:id="0"/><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">stralia. </w:t></w:r></w:p><w:p w14:paraId="742357E4"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00141F34"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">In 2019, we started our training and capability development centre in Kochi, Kerala, to strengthen and upgrade the expertise of top-notch software professionals and niche consultants for global projects in diverse technology applications. </w:t></w:r></w:p><w:p w14:paraId="0FECC088"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6912EA8B"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Located in Vismaya Building at Infopark Phase 1, Kakkanad, Kochi, we operate as a fully functional engineering, training and delivery centre supporting global clients in various technology workspaces. </w:t></w:r></w:p><w:p w14:paraId="6F17ED41"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="067A5468"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>We build and strengthen capabilities in</w:t></w:r></w:p><w:p w14:paraId="4C02EC39"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Cloud-based platforms, </w:t></w:r></w:p><w:p w14:paraId="3A95C7CF"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Custom software engineering</w:t></w:r></w:p><w:p w14:paraId="51DA0243"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Enterprise ERP systems</w:t></w:r></w:p><w:p w14:paraId="07843598"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">AI-enabled applications </w:t></w:r></w:p><w:p w14:paraId="730F9593"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr></w:p><w:p w14:paraId="79C4CE86"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">We train and upskill our professionals and place them globally in various IT projects with leading IT consulting and software development corporations. </w:t></w:r></w:p><w:p w14:paraId="3AECE729"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2A64F380"><w:pPr><w:rPr><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Our team blends knowledge, experience and fresh thinking to deliver technology and talent solutions that stand apart. We prioritise profiles over our pathways and focus on tech-specific markets that offer promising opportunities for our ‘techies’. </w:t></w:r></w:p><w:p w14:paraId="058EA03E"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="612DBC30"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">We dream of connecting knowledge, expertise and experience worldwide and building a promising workforce in the technology sector worldwide. </w:t></w:r></w:p><w:p w14:paraId="104AC6AB"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4B7F70E9"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7F98677B"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Niche Global- Our Distinct Edge that Makes Us Stand Out </w:t></w:r></w:p><w:p w14:paraId="58303F92"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7C8A49DF"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Global Presence: Global Possibilities </w:t></w:r></w:p><w:p w14:paraId="64A28738"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>We are headquartered in the USA, with our profound presence in the UK, France, Australia, and South Korea. With our global presence, we aspire to create a world of opportunities for our tech professionals, connecting talent and capabilities with global experience and career possibilities.</w:t></w:r></w:p><w:p w14:paraId="49A67604"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="303C8329"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Our Kochi Story- The Powerhouse of Training and Capability Development  </w:t></w:r></w:p><w:p w14:paraId="47661B06"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Ever since its inception in 2019, our Kochi unit has emerged as a strategic centre to elevate and strengthen our training capabilities for a future-ready talent force.</w:t></w:r></w:p><w:p w14:paraId="6E500ED6"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6F206228"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Your Profile Leads the Way </w:t></w:r></w:p><w:p w14:paraId="25D6B7B5"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">We highlight and emphasise your education, experience and ambitions to develop opportunities around you. Your profile helps us to build a pathway for you worldwide. </w:t></w:r></w:p><w:p w14:paraId="0BB64D54"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="726A2277"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">From Career Goals to Global Opportunities </w:t></w:r></w:p><w:p w14:paraId="663C807B"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">We are dedicated to placing your career pathways in the global space. We are passionate about identifying your strengths and expertise, positioning them strategically. </w:t></w:r></w:p><w:p w14:paraId="0ED60CDC"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0EB6FAA9"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Strategically-Focussed Markets: Strategically-Focussed Vision </w:t></w:r></w:p><w:p w14:paraId="61C312ED"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">From finding your core expertise to placing your skills and knowledge, we build strategic career pathways designed to augment your talent into the global arena confidently. </w:t></w:r></w:p><w:p w14:paraId="292F7920"><w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="62BAFD8A"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Our Team &amp; Office</w:t></w:r></w:p><w:p w14:paraId="00652353"><w:pPr><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5CECC8EF"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">We are headquartered at 8425 Pulsar Place, Suite #280, Columbus, Ohio, USA. Along with the USA, we are also operational in the UK, France, South Korea and Australia. </w:t></w:r></w:p><w:p w14:paraId="46BAE405"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">Our India office is InfoPark Phase 1, Kochi, Kerala. This is a training and capability-building centre where we impart knowledge and skills to our techie professionals before placing them in global IT ecosystems. </w:t></w:r></w:p><w:p w14:paraId="3541B72B"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">We aim to align our training path and methodology with international technology standards and evolving project needs, creating a strategic bridge between the local workforce and global opportunities. </w:t></w:r></w:p><w:p w14:paraId="05198FAC"><w:pPr><w:pStyle w:val="31"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">What we train and develop in Kochi is prepped and strengthened for the global platform. </w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708" w:num="1"/><w:docGrid w:linePitch="360" w:charSpace="0"/></w:sectPr></w:body></w:document>